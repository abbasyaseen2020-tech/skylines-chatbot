# Sky Lines AI Agent - Environment Variables
# =============================================
# Copy this file to .env and fill in your values

# ===== AI ENGINE (REQUIRED for smart responses) =====
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# AI Model (default: claude-sonnet-4-20250514)
AI_MODEL=claude-sonnet-4-20250514

# ===== FACEBOOK MESSENGER =====
# Get from: developers.facebook.com > Your App > Messenger > Settings
PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN_HERE

# ===== WHATSAPP BUSINESS API =====
# Get from: Meta Business Suite > WhatsApp > API Setup
WHATSAPP_TOKEN=YOUR_WHATSAPP_TOKEN_HERE
WHATSAPP_PHONE_ID=YOUR_PHONE_NUMBER_ID_HERE

# ===== WEBHOOK =====
# Webhook Verify Token (choose any secret string)
VERIFY_TOKEN=skylines_bot_verify_2026

# Server Port
PORT=5000

# ===== GOOGLE SHEETS (optional) =====
# GOOGLE_SHEETS_ID=YOUR_SPREADSHEET_ID
# GOOGLE_CREDENTIALS_PATH=credentials.json
